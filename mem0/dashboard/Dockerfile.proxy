# 仅在【官方 Dockerfile 因离线/代理导致 npm install 失败】时启用:
#   cp dashboard/Dockerfile.proxy dashboard/Dockerfile
# 然后再 docker compose -f docker-compose.yml -f docker-compose.dashboard.yml up -d --build dashboard
#
# 这个 Dockerfile 与官方版的唯一区别: 在 build 阶段把 WSL-NAT-PROXY 透传给 npm,
# 并把 NEXT_PUBLIC_API_URL 在构建时固化 (免去官方镜像依赖运行时 entrypoint 改写)。
FROM node:20-alpine AS builder
ARG NEXT_PUBLIC_API_URL=http://localhost:8000
ARG HTTP_PROXY
ARG HTTPS_PROXY
ENV NEXT_PUBLIC_API_URL=$NEXT_PUBLIC_API_URL \
    HTTP_PROXY=$HTTP_PROXY HTTPS_PROXY=$HTTPS_PROXY \
    http_proxy=$HTTP_PROXY https_proxy=$HTTPS_PROXY \
    NPM_CONFIG_PROXY=$HTTP_PROXY NPM_CONFIG_HTTPS_PROXY=$HTTPS_PROXY
WORKDIR /app
COPY package*.json ./
RUN npm install
COPY . .
RUN npm run build

FROM node:20-alpine AS runner
WORKDIR /app
ENV NODE_ENV=production
COPY --from=builder /app/.next ./.next
COPY --from=builder /app/public ./public
COPY --from=builder /app/node_modules ./node_modules
COPY --from=builder /app/package.json ./package.json
COPY --from=builder /app/next.config.* ./next.config.mjs
EXPOSE 3000
CMD ["npm", "run", "start"]
