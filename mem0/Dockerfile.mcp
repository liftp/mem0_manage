# Standalone MCP thin-forwarding layer for mem0 agent-memory.
# Isolated from the mem0 image on purpose: fastmcp has its own dependency tree and
# we must not risk breaking the working mem0 image.
FROM docker.1ms.run/library/python:3.12-slim

ENV PYTHONUNBUFFERED=1
# Build-time egress: route pip through the WSL-NAT proxy + Aliyun mirror
# (docker.io is blocked by the proxy; Aliyun is reachable through it).
ENV HTTP_PROXY=http://172.20.240.1:17890
ENV HTTPS_PROXY=http://172.20.240.1:17890
ENV PIP_INDEX_URL=https://mirrors.aliyun.com/pypi/simple
ENV PIP_TRUSTED_HOST=mirrors.aliyun.com

WORKDIR /app
RUN pip install --no-cache-dir fastmcp httpx

COPY server/mcp_server.py /app/mcp_server.py

EXPOSE 8001
CMD ["python", "/app/mcp_server.py"]
