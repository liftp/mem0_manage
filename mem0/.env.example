# ============================================================
# mem0 Agent 全局记忆系统 - 环境配置
# 复制为 .env 后填写真实值
# ============================================================

# ---------- LLM (记忆抽取) ----------
# 运行时切换: PROVIDER=deepseek | openai | anthropic | gemini
# 未填 key 时系统仍可启动/读写, 仅 infer=false 的直写可用; 填 key 后自动抽取
LLM_PROVIDER=deepseek
# DeepSeek (默认, 国内可达) - 填入后启用记忆抽取
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat
# OpenAI (切换时填写)
# LLM_PROVIDER=openai
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini
# 阿里云 DashScope 也可走 openai 兼容模式:
#   LLM_PROVIDER=openai + OPENAI_BASE_URL_OVERRIDE=https://dashscope.aliyuncs.com/compatible-mode/v1
#   OPENAI_API_KEY=sk-xxx + OPENAI_MODEL=qwen-plus

# ---------- Embedder ----------
# 默认: fastembed 本地 ONNX (零 key, 模型已随源码固化在 server/models/, 离线可用)
#   arctic-embed-xs: 384 维, 90MB, 英文为主
#   换中文模型: python3 scripts/download_model.sh 下载 BAAI/bge-small-zh-v1.5 后改这里
EMBEDDER_PROVIDER=fastembed
EMBEDDER_MODEL=snowflake/snowflake-arctic-embed-xs
EMBEDDING_DIMS=384

# openai 兼容 embedder (切换 EMBEDDER_PROVIDER=openai 时使用)
OPENAI_API_KEY=
OPENAI_EMBEDDER_MODEL=text-embedding-3-small
# 自定义 OpenAI 兼容 embedder 端点 (留空=官方; 可填 deepseek/dashscope/siliconflow)
OPENAI_EMBEDDER_BASE_URL=

# ---------- Postgres ----------
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=postgres
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me-postgres
POSTGRES_COLLECTION_NAME=memories
APP_DB_NAME=mem0_app

# ---------- mem0 server ----------
MEM0_PORT=8000
# 注意: pydantic EmailStr 拒绝保留域名 (.local/.localhost/.test), 必须用公网风格域名
ADMIN_EMAIL=admin@mem0.dev
ADMIN_PASSWORD=change-me-admin
# bootstrap 自动生成并回填
JWT_SECRET=
AUTH_DISABLED=false
MEM0_TELEMETRY=false

# ---------- 模型下载源 (fastembed 用) ----------
# 默认 huggingface.co 不可达, 走 hf-mirror 镜像
HF_ENDPOINT=https://hf-mirror.com

# ---------- 项目命名 ----------
DEFAULT_PROJECT=default
